---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const crafts = (await getCollection("crafts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Crafts">
  <p class="font-mono text-sm mb-6"><a href="/" class="text-zinc-400 dark:text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors">~/</a><span class="text-accent dark:text-accent-dark">crafts</span></p>
  <div class="grid gap-4 sm:grid-cols-2">
    {crafts.map((craft) => (
      <ProjectCard
        title={craft.data.title}
        summary={craft.data.summary}
        thumbnail={craft.data.thumbnail}
        href={`/crafts/${craft.id}/`}
        date={craft.data.date}
        tags={craft.data.tags}
      />
    ))}
  </div>
</Base>
